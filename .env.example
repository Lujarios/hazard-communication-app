# Copy this file to ".env" and fill in real values.
# Never commit ".env". Variable names are validated in src/env.js.
#
# Required for both local and hosted runs:
#   DATABASE_URL, OPENAI_API_KEY, AUTH_SECRET
#
# See the README "Setup" and "Hosting checklist" sections for details.

# Drizzle / PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/hazard-communication-app"

# OpenAI (server-side only — used for safety talk feedback evaluation)
OPENAI_API_KEY=""

# Auth.js (required). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin of the app. Local default is http://localhost:3000.
# Set this to your HTTPS URL in production (e.g. https://safetalk.example.com).
# AUTH_URL="http://localhost:3000"

# Set "true" when Auth.js sits behind a reverse proxy / load balancer (typical on AWS).
# AUTH_TRUST_HOST="true"

# Amazon Cognito (optional for local — leave blank to use seed Credentials login).
# If you set one of these, set all three.
# App client ID / secret from Cognito User Pool app client
AUTH_COGNITO_ID=""
AUTH_COGNITO_SECRET=""
# Issuer: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
AUTH_COGNITO_ISSUER=""

# Local email/password login against seeded manager users.
# Defaults to enabled in development. Set "false" to disable; "true" to force on.
# In production, set "false" and use Cognito.
# AUTH_DEV_LOGIN="true"
